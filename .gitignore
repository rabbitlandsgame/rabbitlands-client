__pycache__/
*.py[cod]
# Local video model weights, Python runtime, caches, and generated clips.
/.local/video-generation/
godot-client/.godot/
godot-client/test-artifacts/
# Short Windows junction to the ignored engine-profile build, avoiding MAX_PATH.
/ep/
godot-client/**/*.import
godot-client/**/*.uid
godot-client/assets/actors/native/races/* *.png
godot-client/assets/actors/native/hair/* *.png

# macOS Specific
.DS_Store
.DS_Store?
xcuserdata/

# CLion workspace files
.idea/

# The Godot editor/runtime binary, kept beside the project for local runs. It
# is 180 MB and must never enter a commit.
godot-client/Godot_v*.exe
godot-client/Godot_v*

# Godot editor artefacts. A headless import of the godot-client project
# ("godot --headless --path godot-client --import") regenerates all of these
# in a fresh checkout, so none of them belong in the tree.
godot-client/.godot/
*.import
# Shared ground-class textures ship their full lossless mip chains.
!godot-client/src/world/look/textures/beach-sand.png.import
!godot-client/src/world/look/textures/coastal-gravel.png.import
!godot-client/src/world/look/textures/flagstone-paving.png.import
!godot-client/src/world/look/textures/packed-earth-path.png.import
!godot-client/src/world/look/textures/tilled-soil.png.import
# Biome masks encode four independent numeric weights, including alpha.
# Keep their import settings so Godot never bleeds RGB under zero alpha.
!godot-client/assets/world/biome_blend/masks/*.png.import
# The RL head's maps load from the PCK as imported: VRAM-compressed with
# mipmaps (BPTC, without alpha-border fixing, for the channel-packed masks;
# features2 at 1024 px). Keep their import settings so a checkout draws what a
# package ships (tools/package_client.py LOADED_IMAGE_FOLDERS).
!godot-client/assets/actors/native/rl_head_textures/*.png.import
# The RL head's GLBs are a loose-only actor folder: its local import guard
# (AGENTS.md; actor_shipping loose_folders) is generated, never committed.
godot-client/assets/actors/native/rl_heads/.gdignore
*.uid
godot-client/assets/actors/native/creatures/*-basecolor.png
godot-client/assets/actors/native/races/*Atlas.png
godot-client/**/*.glb.report.json
# Textures extracted by Godot from the self-contained Meshy storage GLB.
godot-client/assets/world/interactives/storage_[0-9].jpg
# Textures extracted by Godot from the self-contained underground scenery GLBs.
godot-client/assets/world/underground/*_[0-9].jpg
godot-client/assets/world/underground/*_[0-9].png
# (pass 2 wave A) the plank walk's source keeps its kit texture's name
godot-client/assets/world/underground/*_kit-*.jpg

# Rendered test evidence written by local test runs.
godot-client/test-artifacts/

# Validator reports written beside the map packages they describe.
eloria-assets/maps/*/world.glb.report.json

# VRAM-compressed sidecars of the shared map images, and their encode cache:
# built by godot-client/tools/build_vram_textures.py at package time, never
# tracked (the package stage gets its own copy).
eloria-assets/maps/**/shared-assets/vram/
# The same for one map's images in the shared image pool (--unskip-map) and for
# the embedded images of scenery GLBs (--scenery-config; world_object_images.gd).
eloria-assets/maps/_shared/images/vram/
godot-client/assets/world/**/vram/
/.vram-encode-cache/
# The tool's per-image quality numbers (also beside the committed test sidecars).
**/shared-assets/vram/report.json

# The Godot editor/runtime binary. Sessions copy it into godot-client/ to run
# the capture and client-check harnesses; at 172 MB it is over GitHub's file
# size limit and must never be committed.
godot-client/Godot_v*.exe

# Generated beside strings.csv by the CSV translation importer.
godot-client/**/*.translation

# T-pose pipeline snapshots, intermediate models and render evidence.
/tpose-body-build/
# Textures extracted by Godot while importing self-contained body GLBs.
godot-client/assets/actors/native/races/*_texture_0.png
godot-client/assets/actors/native/races/*_wardrobe_grey.png
godot-client/assets/actors/native/races/*_base_color.jpg
godot-client/assets/actors/native/races/*_metallic_roughness.jpg
godot-client/assets/actors/native/races/*_normal.jpg
godot-client/assets/actors/native/races/*_[0-9].png
godot-client/assets/actors/native/equipment/*_[0-9].png
godot-client/assets/actors/native/equipment/*_[0-9].jpg

# Additional textures extracted by Godot 4.7 from the embedded actor GLBs.
# Keep these generated sidecars beside the imports without staging them.
godot-client/assets/actors/native/mounts/giant_rat_geometry_0_basecolor.png
godot-client/assets/actors/native/mounts/giant_rat_geometry_0_normal.png
godot-client/assets/actors/native/**/*_base_color.jpg
godot-client/assets/actors/native/**/*_basecolor.jpg
godot-client/assets/actors/native/**/*_normal.jpg
godot-client/assets/actors/native/**/*_metallic_roughness.jpg
godot-client/assets/actors/native/**/*_Image_0.jpg
godot-client/assets/actors/native/creatures/*_base_color_[0-9].jpg
godot-client/assets/actors/native/creatures/*_metallic_roughness_[0-9].jpg
godot-client/assets/actors/native/creatures/*_normal_[0-9].jpg
godot-client/assets/actors/native/races/*_[0-9].jpg
godot-client/assets/actors/native/races/*_texture_0.jpg
godot-client/assets/actors/native/races/luminous_*_basecolor.png
godot-client/assets/actors/native/hair/**/*_Native Hair * Base Color.jpg
godot-client/assets/actors/native/hair/**/*_Native Hair * Normal.jpg

# pytest caches (any directory)
.pytest_cache/

# Native crowd prototype outputs and its fetched, pinned godot-cpp checkout.
# Source and build metadata live in godot-client/native/native_crowd; generated
# binaries are copied into the project only for an explicit benchmark run.
godot-client/native/native_crowd/build/
godot-client/native/native_crowd/.deps/
godot-client/bin/native_crowd*
godot-client/bin/**/native_crowd*
godot-client/native/client_runtime/build/
godot-client/native/client_runtime/.deps/
godot-client/native/client_runtime/core/target/
godot-client/bin/client_runtime/

# A checkout's own project-settings override. The continent-v2 viewer launcher and the editor-pass runners
# write godot-client/override.cfg to bind the v2 territory catalog there (serve plan CV12a).
godot-client/override.cfg

# Preserve dense contact-constrained canine curves on clean imports.
!godot-client/assets/actors/native/creatures/briarhide_wolf.glb.import
!godot-client/assets/actors/native/creatures/crystal_dire_wolf.glb.import
!godot-client/assets/actors/native/creatures/moss_armored_hound.glb.import
!godot-client/assets/actors/native/creatures/mossbound_hound.glb.import
!godot-client/assets/actors/native/creatures/red_fox.glb.import
!godot-client/assets/actors/native/creatures/thornbark_wolf.glb.import
!godot-client/assets/actors/native/creatures/thornhide_wolf.glb.import

# Local high-resolution source assets and their authoring workspace.
/.local/asset-authoring/

# Disposable local game accounts, logs, screenshots and developer test profiles.
/.local/qa/

# Local Claude Code files: settings, worktrees and skill discovery links.
/.claude/

