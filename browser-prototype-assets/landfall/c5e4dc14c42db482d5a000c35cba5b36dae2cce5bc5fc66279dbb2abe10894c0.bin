w␀␀␀Script␀0␀␀␀res://src/camera/isometric_camera_controller.gd␀¥Ž)Jô@W␀␀␀Script␀␀␀␀res://src/ui/chat_hud.gd␀Èf¦71O7␀␀␀␀␀␀local://Shader_login_landfall␀å␀␀␀␀␀␀&␀␀␀local://ShaderMaterial_login_landfall␀O␀␀␀␀␀␀␀␀␀local://Environment_world␀š␀␀␀␀␀␀␀␀␀local://Material_ground␀
␀␀␀␀␀␀␀␀␀local://Mesh_ground␀Q␀␀␀␀␀␀␀␀␀local://Material_map_marker␀‹␀␀␀␀␀␀␀␀␀local://Mesh_map_marker␀Þ␀␀␀␀␀␀$␀␀␀local://Material_map_marker_outline␀/␀␀␀␀␀␀ ␀␀␀local://Mesh_map_marker_outline␀Ž␀␀␀␀␀␀ ␀␀␀local://Material_preview_ground␀ß␀␀␀␀␀␀␀␀␀local://Mesh_preview_ground␀&␀␀␀␀␀␀␀␀␀local://Environment_preview␀ƒ␀␀␀␀␀␀␀␀␀local://PackedScene_xkv1l␀ó␀␀␀␀␀␀␀␀␀Shader␀␀␀␀␀␀␀␀␀␀G␀␀shader_type canvas_item;
render_mode unshaded;

uniform float animation_strength : hint_range(0.0, 1.0) = 1.0;
uniform float motion_amount : hint_range(0.0, 0.01) = 0.0024;

void fragment() {
	float slow_wave = sin(TIME * 0.12);
	float slow_lift = cos(TIME * 0.09);
	float zoom = 1.008 + (0.002 * sin(TIME * 0.07) * animation_strength);
	vec2 sample_uv = (UV - vec2(0.5)) * zoom + vec2(0.5);
	sample_uv += vec2(slow_wave, slow_lift) * motion_amount * animation_strength;
	vec4 painted_scene = texture(TEXTURE, clamp(sample_uv, vec2(0.001), vec2(0.999)));

	COLOR = painted_scene;
}
