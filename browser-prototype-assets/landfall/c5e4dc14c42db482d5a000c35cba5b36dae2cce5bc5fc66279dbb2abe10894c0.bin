%•␀B•ðÑŸkœBT<FXHV1Hë”Tv¯@äO)#_¥ÙóÅ˜‚º¨²›/I"))(H†1RÇI)­ì@'L“ $¤$¥e¬$–WsaìE0˜aÍ¡_‰;f\`ON—´lîl’Q£ÙÕ?Ø…–êŠ³üÇKúÄD»ÖÀ\912WeTfîá5E¯‡vøîWð z!l„gê	Û=iãn<ÁŠìF¤±(ú&ìFÊµ[qPú~tÇd–<óÏüf#l§™À;Ç1´bMB_I]$)û‹¶±Éë`-%Í4Í$£^5’4”nádÖ\æÛÖÁÏx4Â@«ŒwOP¾Š™Óˆ3\•Œ?bí#eG#ç³Í)¨ó£Ò!ŠôY-âŠ6}À ªZGa¾¥³;¡q·\˜=hóÐKëûŒññ[{ä××7Û÷ŸONÃÄ˜Lh¨-sE¦;¤ò ÍµÞIàþš	CÁÄa_1´É¸¹r¸ŸùÅáÎFa ÏÇ™Æ[°nkÃŽìñio¹ÿ6_„sÄh°ò[¶õLáíM~Åés/wÉY?1ðf”“×ût/ÎµLLo›{"šÆúº1*²†‡ÍQp±•…B+èïèàÎ÷'ÒXjnÒ%ÐY·ºr1šfgñå4YÎ’¸è‚Jå¥²o;TÔžÏÀ•`Ãª%ûBÙÈµ KÀ|€j¢Û(LÝçÆnRh9[{ÅÈ™Ý©ÛÅóOas-ãë§Ü„´¦ï©üûõÛÙ´y­òäMâTŽèÊ/RKœ®Ô–Ó"␀íö~§k_rwKÏ^Áaç"O¿{ðÊÛœ—'ÊcíYbxýß÷;?ÀƒöQ¶|õú»vð„w#¹eèŠùGÅ¯aúk9–=É–ÏŠ_Þgç6¿/ÂäW|D\þ§Ç_å|†HÿLv‘Ð>4ªÎ’W!ý iþráëI§#È²-(šÀFæm—[¦»ä×ª©—#,³;o‘×7ç3Â{sþÿ	ógŸ­èÓNX‰O¥Þ"MOn¢ØŒrbüìÆ½·hÎMyíñÁÈŒ_Öíó±i|ÄÒk”f÷ÈW‡ý¸S„!À·O¸g­÷¢kl —Hþ›üÎaj0žYò?ÖÓw”Ø’5E_\Œé×v6ÚÜ_ùÅö+`/}¾¶Ãüó{äp×å}Ç3 s~°NžšÜ†ÓÄÑâm␀␀␀␀␀␀␀␀␀␀␀␀␀␀// CUSTOM0 is copied from source positions before skinning. Spatial VERTEX
// already contains RD's posed position and cannot define a rest-space cut.
uniform bool smooth_shirt_neckline = false;
varying vec3 neck_rest_position;

bool below_shirt_neckline(vec3 point) {
	if (abs(point.x) < 0.185 && point.z > -0.18 && point.z < 0.12 && point.y > 1.30) {
		float angle = atan(point.x, point.z + 0.030);
		float front = max(cos(angle), 0.0);
		float side = sin(angle);
		float front_squared = front * front;
		float rim = 1.50 + 0.010 * side * side - 0.075 * front_squared * front_squared;
		return point.y < rim - 0.001;
	}
	return false;
}
␀shader_type spatial;

// Stamps the stencil buffer wherever the actor is genuinely visible, and draws
// nothing at all. It is depth-tested like any transparent surface, so a
// fragment the world has already covered never reaches here and never stamps.
//
// Applied as `material_overlay` on the actor's own mesh instances, so it does
// not disturb the imported materials, the appearance tints, or the equipment
// system - all of which own `material_override`.
render_mode unshaded, depth_draw_never, blend_mix, shadows_disabled;
stencil_mode write, compare_always, 1;

void fragment() {
	ALBEDO = vec3(0.0);
	ALPHA = 0.0;
}
