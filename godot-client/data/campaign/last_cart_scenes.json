      "lines": [
        {
          "at": 0.0,
          "speaker": "",
          "text": "The worker is free, treated, and safely ashore. The crew has secured the cart."
        },
        {
          "at": 8.0,
          "speaker": "Dock Worker",
          "text": "Thank you. I thought the cart would move again before anyone could lift it.",
          "speaker_actor": "worker"
        },
        {
          "at": 18.0,
          "speaker": "Odo Fenn",
          "text": "While you were helping, the clerk checked the cargo records. There is a problem with the fitting still on that cart.",
          "speaker_actor": "odo"
        },
        {
          "at": 30.0,
          "speaker": "Odo Fenn",
          "text": "Its plate reads K-17. Greenlight and Twinbrook each have a work order saying that same fitting was already installed and tested.",
          "speaker_actor": "odo"
        },
        {
          "at": 40.0,
          "speaker": "Odo Fenn",
          "text": "When you are ready, compare the fitting with its records. Let us find out what actually came ashore.",
          "speaker_actor": "odo"
        }
      ]
    },
