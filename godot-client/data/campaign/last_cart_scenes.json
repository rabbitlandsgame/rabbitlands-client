      "lines": [
        {
          "at": 0.0,
          "speaker": "Odo Fenn",
          "text": "One numbered fitting is still here. Greenlight and Twinbrook both have records saying that same fitting was installed and tested.",
          "speaker_actor": "odo",
          "variants": {
            "installation": "We have reached the Twinbrook works. Its completion record names the fitting we examined at Greenlight."
          }
        },
        {
          "at": 10.0,
          "speaker": "Odo Fenn",
          "text": "You can examine the kit, reconstruct the unloading with witnesses, or compare the independent records. Follow a lead you can verify.",
          "speaker_actor": "odo",
          "variants": {
            "installation": "Check the installed plate and valve, then run the service test. We need to see what is fitted here, not guess from a signature."
          }
        },
        {
          "at": 22.0,
          "speaker": "Odo Fenn",
          "text": "A copied record, a changed destination, or a false sign-off could explain this. We do not know which yet.",
          "speaker_actor": "odo",
          "variants": {
            "installation": "If the equipment and the record disagree, keep both observations. A working pump does not prove this particular fitting was installed."
          }
        },
        {
          "at": 32.0,
          "speaker": "Odo Fenn",
          "text": "Which lead will you start with?",
          "speaker_actor": "odo",
          "variants": {
            "installation": "Record what the equipment actually shows. Then we can decide what the conflicting claims mean."
          }
        },
        {
          "at": 44.0,
          "speaker": "Odo Fenn",
          "speaker_actor": "odo",
          "text": "Follow the marked lead. You can compare the other sources before returning with a finding.",
          "variants": {
            "installation": "Record what the installed equipment actually shows. Keep those measurements with the claim before drawing a conclusion."
          }
        }
      ],
      "choice_id": "claims_lead",
      "choice_at": 32.0,
      "choice_response_until": 44.0
    },
