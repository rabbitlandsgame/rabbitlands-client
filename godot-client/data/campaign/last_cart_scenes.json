      ],
      "lines": [
        {
          "at": 0.0,
          "speaker": "Odo Fenn",
          "text": "Your evidence puts this fitting on the pier after the records say it was already installed. Those accounts cannot both be right.",
          "speaker_actor": "odo",
          "variants": {
            "installation": "The plate and service test establish what is actually installed here. It does not match the completed work described in the record."
          }
        },
        {
          "at": 10.0,
          "speaker": "Odo Fenn",
          "text": "That is a discrepancy we can show. It does not tell us who caused it, or whether the mistake was deliberate.",
          "speaker_actor": "odo"
        },
        {
          "at": 22.0,
          "speaker": "Odo Fenn",
          "text": "Our next check is the actual installation at Twinbrook. We will travel there normally and compare the equipment with the claim.",
          "speaker_actor": "odo",
          "variants": {
            "installation": "We have a physical account as well as a written one now. Keep them together as we follow the next part of the work."
          }
        }
      ]
