      "lines": [
        {
          "at": 0.0,
          "speaker": "",
          "text": "A loaded handcart rolls as its brake slips. The shaft catches a worker's ankle beneath the load."
        },
        {
          "at": 8.0,
          "speaker": "Odo Fenn",
          "text": "Keep it steady. We will get his leg free.",
          "speaker_actor": "odo"
        },
        {
          "at": 16.0,
          "speaker": "Dock foreman",
          "text": "The brake gave way. His ankle is pinned by the shaft. I cannot lift the loaded cart alone.",
          "speaker_actor": "foreman"
        },
        {
          "at": 26.0,
          "speaker": "Odo Fenn",
          "text": "Look at the brake, the load, and the shaft before we pull. We need to move it safely.",
          "speaker_actor": "odo"
        },
        {
          "at": 36.0,
          "speaker": "",
          "text": "You approach the cart and examine how the shaft is holding the worker."
        },
        {
          "at": 43.0,
          "speaker": "You",
          "text": "We can lighten the load, lift the shaft with a lever, or rig a controlled pull. The cart must stay secured.",
          "speaker_actor": "protagonist"
        },
        {
          "at": 52.0,
          "speaker": "Odo Fenn",
          "text": "Which method will you use? The dock tools are here, and we can help.",
          "speaker_actor": "odo"
        },
        {
          "at": 72.0,
          "speaker": "Odo Fenn",
          "text": "I will stay with the worker. Follow the marked task, and tell us when you are ready.",
          "speaker_actor": "odo"
        }
      ]
    },
