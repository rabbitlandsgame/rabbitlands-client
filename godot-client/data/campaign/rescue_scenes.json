      "lines": [
        {
          "at": 2,
          "speaker": "",
          "text": "A cry cuts across the road below Landfall's south gate."
        },
        {
          "at": 8,
          "speaker": "Girl",
          "text": "Mum! My foot—",
          "speaker_actor": "daughter"
        },
        {
          "at": 16,
          "speaker": "Goblin raider",
          "text": "Ha! Little feet. Easy catch.",
          "speaker_actor": "abductor"
        },
        {
          "at": 25,
          "speaker": "Woman",
          "text": "Liora! Let her go!",
          "speaker_actor": "mother"
        },
        {
          "at": 34,
          "speaker": "Woman",
          "text": "Please. Help me stop them!",
          "speaker_actor": "mother"
        },
        {
          "at": 60,
          "speaker": "Woman",
          "speaker_actor": "mother",
          "text": "Thank you! Keep him away from me!",
          "when": "help"
        }
