        {"t": 17.0, "anchor": "worker_safe", "position": [-3.0, 4.5, 7.0], "target": [0.0, 1.2, 2.0]}
      ],
      "cues": [
        {"at": 0.0, "actor": "voss", "action": "defend", "offset": [0, 0, 1], "move_seconds": 0.8, "face": "sluice_prop"},
        {"at": 0.0, "actor": "worker", "action": "idle", "destination": "worker_trapped", "face": "worker_safe"},
        {"at": 2.0, "actor": "worker", "action": "walk", "from": "worker_trapped", "destination": "worker_safe", "move_seconds": 6.0, "face": "worker_safe"},
        {"at": 9.0, "actor": "worker", "action": "idle", "destination": "worker_safe", "face": "bypass"},
        {"at": 10.0, "actor": "voss", "action": "idle", "offset": [0, 0, 0], "move_seconds": 0.8, "face": "worker_safe"},
        {"at": 11.0, "actor": "odo", "action": "emote_nod", "offset": [0, 0, 0], "face": "worker_safe"}
      ],
      "lines": [
        {"at": 0.0, "speaker": "Serit Voss", "text": "The brace is holding. Go now; I am staying here until you are clear."},
        {"at": 8.5, "speaker": "Works Hand", "text": "Across and safe. Nobody left behind."},
        {"at": 11.0, "speaker": "Odo Fenn", "text": "Now we can install the salvaged part and make an honest test.", "variants": {"medical": "Your medical reserve is ready. The crew will operate a braced bypass while we test the work.", "pump": "The pump fitting you saved can now be installed. The care station has spent its reserve."}},
        {"at": 14.0, "speaker": "Odo Fenn", "text": "The intake and diversion do different jobs. Watch the water, then compare the independent gauge."}
      ]
    },
    "measure.twinbrook.flow": {
      "title": "Read the Water",
      "show_readouts": true,
      "duration": 14.0,
      "anchor": "gauge",
      "shots": [
        {"t": 0.0, "position": [4.0, 4.3, 7.0], "target": [0.0, 1.1, 0.0]},
        {"t": 6.0, "anchor": "flow", "position": [4.0, 5.5, 8.0], "target": [-1.5, 0.4, 0.0]},
        {"t": 14.0, "anchor": "gauge", "position": [3.0, 4.5, 7.0], "target": [0.0, 1.1, 0.0]}
      ],
      "cues": [
        {"at": 0.0, "actor": "odo", "action": "emote_greet", "offset": [0, 0, 0], "face": "gauge"},
        {"at": 5.0, "actor": "odo", "action": "idle", "offset": [0, 0, 0], "face": "flow"}
      ],
      "lines": [
        {"at": 0.0, "speaker": "Odo Fenn", "text": "The stream tells you what the controls are doing. The gauge supplies an independent comparison."},
        {"at": 5.0, "speaker": "Odo Fenn", "text": "A mark in the permitted column is a claim. A reading you can reproduce is evidence."},
        {"at": 10.0, "speaker": "Odo Fenn", "text": "Record the result you observed. Then decide how this account should be shared."}
      ]
    },
    "measure.twinbrook.resolved": {
      "title": "Four People, One Account",
      "duration": 14.0,
      "anchor": "gauge",
      "shots": [
        {"t": 0.0, "position": [8.0, 8.0, 12.0], "target": [0.0, 1.0, 0.0]},
        {"t": 7.0, "position": [-4.0, 5.0, 9.0], "target": [-1.5, 1.1, 0.0]},
        {"t": 14.0, "position": [-4.0, 5.0, 9.0], "target": [-1.5, 1.1, 0.0]}
      ],
      "cues": [
        {"at": 0.0, "actor": "odo", "action": "emote_nod", "offset": [0, 0, 0], "face": "gauge"},
        {"at": 4.0, "actor": "voss", "action": "idle", "offset": [0, 0, 0], "face": "gauge"}
      ],
      "lines": [
        {"at": 0.0, "speaker": "Odo Fenn", "text": "The crew is safe and the test can be repeated. Your chosen account stays with the evidence."},
        {"at": 5.0, "speaker": "Serit Voss", "text": "Then put down what happened here, including what it cost."},
        {"at": 9.0, "speaker": "", "text": "Party members choose individually whether to record this outcome. Helping another expedition does not overwrite your own story."}
      ]
    },
