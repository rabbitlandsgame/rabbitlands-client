      ],
      "lines": [
        {
          "at": 0,
          "speaker": "Ammet Sorrel",
          "text": "You call it temporary, Odo. The shortage still reaches my roots."
        },
        {
          "at": 4,
          "speaker": "Odo Fenn",
          "text": "I kept the crew's intake open. I didn't tell you what that left for the grove."
        },
        {
          "at": 10,
          "speaker": "Ammet Sorrel",
          "text": "Then give me an account I can check: which load, which route, and who pays to put it right.",
          "variants": {
            "public": "Public numbers aren't enough. Show which work took the load, and what it cost the grove.",
            "protected": "Keep your witness unnamed. Give me an account I can check on the ground.",
            "supervised": "I'll hear a witnessed account. Show the work and write down the grove's cost."
          }
        },
        {
          "at": 16,
          "speaker": "Odo Fenn",
          "text": "Choose a way across. We'll follow the marks and test the diversion together."
        }
      ]
