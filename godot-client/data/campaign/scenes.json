    "measure.landing.arrival": {
      "title": "The Ferry That Arrived Twice",
      "duration": 24.0,
      "anchor": "odo",
      "shots": [
        {"t": 0.0, "position": [-7.0, 6.0, 10.0], "target": [0.0, 1.1, 0.0]},
        {"t": 5.0, "position": [-4.0, 3.4, 6.0], "target": [0.0, 1.3, 0.0]},
        {"t": 12.0, "position": [4.0, 3.0, 6.0], "target": [0.0, 1.1, 0.0]},
        {"t": 20.0, "position": [3.0, 4.5, 8.0], "target": [0.0, 1.0, 0.0]},
        {"t": 24.0, "position": [3.0, 4.5, 8.0], "target": [0.0, 1.0, 0.0]}
      ],
      "cues": [
        {"at": 0.0, "actor": "worker", "action": "idle", "offset": [0.0, 0.0, 0.0]},
        {"at": 3.0, "actor": "odo", "action": "walk", "offset": [0.65, 0.0, 0.0], "move_seconds": 2.0},
        {"at": 5.0, "actor": "odo", "action": "emote_greet", "offset": [0.65, 0.0, 0.0]},
        {"at": 10.0, "actor": "odo", "action": "idle", "offset": [0.65, 0.0, 0.0]}
      ],
      "lines": [
        {"at": 0.0, "speaker": "", "text": "A supply boat has reached the quay. Damaged access leaves its workers stranded."},
        {"at": 5.0, "speaker": "Odo Fenn", "text": "The landing can wait. Get them onto dry ground."},
        {"at": 10.0, "speaker": "Landing clerk", "text": "This cargo was signed in yesterday."},
        {"at": 14.0, "speaker": "Worker", "text": "Then yesterday can lend us a hand."},
        {"at": 18.0, "speaker": "Odo Fenn", "text": "Hold the approach, mend the access, or help move the injured. Tell me where you need me."}
      ]
    },
    "measure.landing.resolved": {
      "title": "Everyone on Dry Ground",
      "duration": 12.0,
      "anchor": "odo",
      "shots": [
        {"t": 0.0, "position": [-4.0, 3.8, 7.0], "target": [0.0, 1.0, 0.0]},
        {"t": 12.0, "position": [-2.0, 3.2, 6.0], "target": [0.0, 1.2, 0.0]}
      ],
      "cues": [{"at": 1.0, "actor": "odo", "action": "emote_greet", "offset": [0.0, 0.0, 0.0]}],
      "lines": [
        {"at": 0.0, "speaker": "Odo Fenn", "text": "Every worker is accounted for. Now we can ask why two orders claim the same cargo."},
        {"at": 6.0, "speaker": "Worker", "text": "The chest and fittings are secure. We will put your chosen priority to work first.", "variants": {"medical": "The dry medical chest comes first. The pump crate will wait in salvage holding.", "pump": "The pump fittings come first. The care station will draw on its emergency reserve."}}
      ]
    },
    "measure.claims.revealed": {
      "title": "One Cargo, Two Claims",
      "duration": 10.0,
      "anchor": "odo",
      "shots": [
        {"t": 0.0, "position": [4.0, 3.5, 7.0], "target": [0.0, 1.0, 0.0]},
        {"t": 10.0, "position": [2.5, 3.2, 6.0], "target": [0.0, 1.2, 0.0]}
      ],
      "cues": [{"at": 0.0, "actor": "odo", "action": "idle", "offset": [0.0, 0.0, 0.0]}],
      "lines": [
        {"at": 0.0, "speaker": "Odo Fenn", "text": "The seals agree. The cargo and the witnesses do not."},
        {"at": 5.0, "speaker": "Odo Fenn", "text": "Keep the independent account. A claim on paper cannot make one fitting serve two works."}
      ]
    },
