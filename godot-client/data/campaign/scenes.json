        {"t": 20.0, "position": [3.0, 4.0, 7.0], "target": [0.0, 1.0, 0.0]}
      ],
      "cues": [
        {"at": 0.0, "actor": "voss", "action": "emote_greet", "offset": [0.0, 0.0, 0.0]},
        {"at": 3.0, "actor": "voss", "action": "idle", "offset": [0.0, 0.0, 0.0]},
        {"at": 5.0, "actor": "worker", "action": "walk", "offset": [0.8, 0.0, 0.0], "move_seconds": 2.0},
        {"at": 9.0, "actor": "worker", "action": "idle", "offset": [0.8, 0.0, 0.0]},
        {"at": 12.0, "actor": "odo", "action": "emote_greet", "offset": [0.0, 0.0, 0.0]}
      ],
      "lines": [
        {"at": 0.0, "speaker": "Serit Voss", "text": "Keep the crew clear. I can hold the bypass."},
        {"at": 5.0, "speaker": "", "text": "Voss stays at the work while the crew withdraws. The salvaged equipment can now be installed."},
        {"at": 10.0, "speaker": "Odo Fenn", "text": "Our crew will hold the bypass while we take the reading.", "variants": {"medical": "Your medical chest is ready. We will hold a crew-operated bypass until the fittings are recovered.", "pump": "Your pump fittings are ready. The care station has used its reserve; the test mechanism can now work properly."}},
        {"at": 15.0, "speaker": "Odo Fenn", "text": "Try the marked gauge yourself. Then decide who should see the account."}
      ]
    },
    "measure.sluice.resolved": {
      "title": "The Account We Keep",
      "duration": 10.0,
      "anchor": "odo",
      "shots": [
        {"t": 0.0, "position": [-3.0, 4.0, 7.0], "target": [0.0, 1.1, 0.0]},
        {"t": 10.0, "position": [-3.0, 4.0, 7.0], "target": [0.0, 1.1, 0.0]}
      ],
      "cues": [{"at": 1.0, "actor": "odo", "action": "emote_greet", "offset": [0.0, 0.0, 0.0]}],
      "lines": [
        {"at": 0.0, "speaker": "Odo Fenn", "text": "We have a reading, witnesses, and your decision. That is an account worth keeping."},
        {"at": 5.0, "speaker": "", "text": "The first emergency is over. Your work and chosen account have been recorded."}
      ]
    },
    "measure.twinbrook.arrival": {
      "title": "The Work at Twinbrook",
      "duration": 22.0,
      "anchor": "sluice_prop",
      "fov": 52.0,
      "shots": [
        {"t": 0.0, "position": [9.0, 9.0, 15.0], "target": [2.0, 1.0, -2.0]},
        {"t": 6.0, "position": [4.0, 3.0, -4.8], "target": [0.0, 1.2, -1.0]},
        {"t": 14.0, "position": [-5.0, 5.5, 10.0], "target": [1.0, 1.0, -3.0]},
        {"t": 22.0, "position": [-5.0, 5.5, 10.0], "target": [1.0, 1.0, -3.0]}
      ],
      "cues": [
        {"at": 0.0, "actor": "voss", "action": "defend", "offset": [0, 0, 1], "move_seconds": 0.8, "face": "sluice_prop"},
        {"at": 0.0, "actor": "worker", "action": "idle", "destination": "worker_trapped", "face": "worker_safe"},
        {"at": 2.0, "actor": "odo", "action": "walk", "offset": [0.75, 0, 0], "move_seconds": 1.2, "face": "bypass"},
        {"at": 7.0, "actor": "odo", "action": "emote_greet", "offset": [0.75, 0, 0], "face": "bypass"},
        {"at": 11.0, "actor": "odo", "action": "idle", "offset": [0.75, 0, 0], "face": "bypass"}
      ],
      "lines": [
        {"at": 0.0, "speaker": "", "text": "At the private test work, a stranded crew waits beyond a bypass that will not stay open."},
        {"at": 5.0, "speaker": "Serit Voss", "text": "Leave the part alone. Brace this bypass and get the crew clear first."},
        {"at": 10.0, "speaker": "Odo Fenn", "text": "I will show the controls. You can hold the approach or help the work. Keep a safe way back."},
        {"at": 16.0, "speaker": "Odo Fenn", "text": "Check the bypass, secure its brace, then release the crew. We fit the salvaged equipment after everyone is safe."}
      ]
    },
    "measure.twinbrook.voss_rescue": {
      "title": "The Crew Comes First",
      "duration": 17.0,
      "anchor": "sluice_prop",
      "fov": 53.0,
      "shots": [
        {"t": 0.0, "position": [6.0, 7.5, 13.0], "target": [3.0, 1.0, -3.0]},
