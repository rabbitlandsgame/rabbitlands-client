// A surface of a shared RL head mesh this quality, or the current contract,
// does not draw (the cornea below HIGH, the brow cards while brows are painted).
// Godot has no per-surface visibility; this costs a depth-only draw of a few
// hundred triangles and draws nothing.
shader_type spatial;
render_mode unshaded, cull_back, depth_draw_never, shadows_disabled;

void fragment() {
	discard;
}
