static func pose_for(sex: String) -> Dictionary:
	return (POSES.get(sex, {}) as Dictionary).duplicate()

static func apply_to_clip(animation: Animation, sex: String) -> void:
	if animation == null:
		return
	var pose := pose_for(sex)
	for track: int in animation.get_track_count():
		if animation.track_get_type(track) != Animation.TYPE_ROTATION_3D: continue
		var bone := str(animation.track_get_path(track).get_concatenated_subnames()).get_slice(":",0)
		if not pose.has(bone): continue
		# The native male knuckle surface is angular. Retain a little of the
		# accepted seed to soften its fold; thumb opposition stays complete.
		var gain := MALE_FINGER_GAIN if sex == "male" and not bone.begins_with("thumb_") else 1.0
		var target: Quaternion = (pose[bone] as Quaternion).normalized()
		for key: int in animation.track_get_key_count(track):
			var original: Quaternion = animation.track_get_key_value(track,key)
			animation.track_set_key_value(track,key,original.slerp(target,gain).normalized())
