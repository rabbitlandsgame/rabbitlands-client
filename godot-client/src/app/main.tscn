[sub_resource type="Shader" id="Shader_login_landfall"]
code = "shader_type canvas_item;\nrender_mode unshaded;\n\nuniform float animation_strength : hint_range(0.0, 1.0) = 1.0;\nuniform float motion_amount : hint_range(0.0, 0.01) = 0.0024;\n\nvoid fragment() {\n\tfloat slow_wave = sin(TIME * 0.12);\n\tfloat slow_lift = cos(TIME * 0.09);\n\tfloat zoom = 1.008 + (0.002 * sin(TIME * 0.07) * animation_strength);\n\tvec2 sample_uv = (UV - vec2(0.5)) * zoom + vec2(0.5);\n\tsample_uv += vec2(slow_wave, slow_lift) * motion_amount * animation_strength;\n\tvec4 painted_scene = texture(TEXTURE, clamp(sample_uv, vec2(0.001), vec2(0.999)));\n\n\tCOLOR = painted_scene;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_login_landfall"]
